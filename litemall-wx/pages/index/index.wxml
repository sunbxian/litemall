<view class="container">
  <!-- 整个可滚动区域 -->
  <scroll-view
    scroll-y
    class="main-scroll"
    bindscroll="onScroll"
    scroll-top="{{scrollTop}}"
    style="height: 100vh;"
  >
    <!-- Banner区域 -->
    <view class="banner-section">
      <swiper class="banner" indicator-dots="true" autoplay="true" interval="3000" duration="1000">
        <swiper-item wx:for="{{banner}}" wx:key="id">
          <block wx:if="{{item.link > 0}}">
            <navigator url="/pages/topicDetail/topicDetail?id={{item.link}}">
              <image src="{{item.url}}" background-size="cover"></image>
            </navigator>
          </block>
          <block wx:else>
            <image src="{{item.url}}" background-size="cover"></image>
          </block>
        </swiper-item>
      </swiper> 
    </view>

    <!-- 内容区域 -->
    <view class="content">
      <!-- 分类列表 -->
      <scroll-view
        class="category-list {{isFixed ? '' : ''}}"
        scroll-y
        style="{{isFixed ? 'top:' + fixedTop + 'px; height:' + categoryHeight + 'px;' : 'height:' + categoryHeight + 'px;'}}"
      >
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="category-item {{activeCategory === index ? 'active' : ''}}"
          bindtap="switchCategory"
          data-index="{{index}}"
        >
          {{item.name}}
        </view>
      </scroll-view>

      <!-- 商品列表 -->
      <view class="product-list">
        <navigator class="item" url="/pages/goods/goods?id={{iitem.id}}" wx:for="{{goodsList}}" wx:key="id" wx:for-item="iitem" wx:for-index="iindex">
          <image class="img" src="{{iitem.picUrl}}" background-size="cover"></image>
          <view class="info">
            <text class="name">{{iitem.name}}</text> 
            <text class="desc">{{iitem.brief}}</text>
            <text wx:if="{{iitem.counterPrice != iitem.retailPrice}}" class="original-price">原价: ￥{{iitem.counterPrice}}</text>
            <text class="price">
              <text class="currency">现价: ￥</text>
              <text class="amount">{{iitem.retailPrice}}</text>
            </text>
            <text wx:if="{{iitem.type==2}}" class="count">共{{iitem.ticketCount}}桶</text>
          </view>
        </navigator>
        <view class="loading-more" wx:if="{{isLoading && page < pages}}">加载中...</view>
      </view>
    </view>
  </scroll-view>

  <!-- 固定位置的分类列表（克隆元素，用于固定效果） -->
  <scroll-view
    class="category-list fixed-clone"
    wx:if="{{isFixed}}"
    style="top: {{fixedTop}}px; height: {{categoryHeight}}px;"
    scroll-y
  >
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="category-item {{activeCategory === index ? 'active' : ''}}"
      bindtap="switchCategory"
      data-index="{{index}}"
    >
      {{item.name}}
    </view>
  </scroll-view>
</view>

<!-- 悬浮的优惠券显示区域 -->
<view class="coupon-float" wx:if="{{showCouponFloat && coupon.length > 0}}">
  <view class="a-section a-coupon">
    <view class="h">
      <view class="title">
        <view>
          <navigator url="/pages/coupon/coupon">
            <text class="txt">优惠券</text>
          </navigator>
        </view>
      </view>
    </view>
    <view wx:if="{{coupon.length > 0}}" class="b">
      <view class="coupon_item" wx:for="{{coupon}}" wx:key="id" bindtap="getCoupon" data-index="{{item.id}}">
        <view class="coupon_price">
          <view>
            <view class="price">{{item.discount}}元</view>
            <view class="p">满{{item.min}}元使用</view>
          </view>
        </view>
        <view class="coupon_msg">
          <view class="coupon_condition">
            <view class="coupon_tag">
              <view class="coupon_tag_text">{{item.tag}}</view>
            </view>
            <view class="text">{{item.name}}</view>
          </view>
          <view class="coupon_instruction">{{item.desc}}</view>
          <view class="coupon_date" wx:if="{{item.days != 0}}">{{item.days}}天</view>
          <view class="coupon_date" wx:else>{{item.startTime}} - {{item.endTime}}</view>
        </view>
      </view>
    </view>
  </view>
  <view class="close-btn" bindtap="closeCouponFloat">×</view>
</view>