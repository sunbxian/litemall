/* editUserInfo.wxss 保持不变 */
.container {
  padding: 20rpx;
  background-color: #f7f7f7;
  min-height: 100vh;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
}

.label {
  width: 150rpx;
  font-size: 30rpx;
  color: #333;
}

.avatar-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #666;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.picker {
  flex: 1;
}

.picker-text {
  font-size: 30rpx;
  color: #333;
}

.submit-btn {
  margin-top: 60rpx;
  width: 90%;
  border-radius: 50rpx;
  font-size: 32rpx;
}