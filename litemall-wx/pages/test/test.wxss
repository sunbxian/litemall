/* 基础样式 */
page {
  height: 100%;
  background-color: #f7f7f7;
}

.container {
  position: relative;
  height: 100%;
  width: 100%;
}

.main-scroll {
  width: 100%;
}

/* Banner区域样式 */
.banner {
  width: 750rpx;
  height: 417rpx;
  overflow: hidden;
}

.banner image {
  width: 100%;
  height: 417rpx;
}

.banner-text {
  text-align: center;
  margin-top: 10px;
  color: #333;
  font-size: 14px;
  background-color: #fff; /* 添加背景色以确保文字清晰 */
  padding: 5px 0;
}

/* 内容区域样式 */
.content {
  display: flex;
  min-height: calc(100vh - 200px); /* 减去banner高度 */
  flex-wrap: nowrap; /* 确保子元素不换行 */
}

/* 分类列表样式 */
.category-list {
  width: 25%;
  background: #fff;
  box-sizing: border-box;
}

.category-list.fixed {
  position: fixed;
  top: 0;
  left: 0;
  opacity: 0; /* 原始元素隐藏，使用克隆元素 */
  pointer-events: none;
}

.fixed-clone {
  position: fixed;
  left: 0;
  width: 25%;
  background: #fff;
  z-index: 20;
  box-sizing: border-box;
}

.category-item {
  padding: 15px 10px;
  text-align: center;
  font-size: 14px;
  border-left: 3px solid transparent;
  transition: all 0.2s;
} 

.category-item.active {
  background: #f5f5f5;  
  border-left: 3px solid #FF4D4F;
  color: #FF4D4F;
  font-weight: bold;
}

/* 商品列表样式 */
.product-list {
  width: 75%;
  box-sizing: border-box;
  padding: 10px;
  flex-shrink: 0; /* 防止宽度被压缩 */
  background: #f5f5f5; 
}

