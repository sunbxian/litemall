/* 基础样式 */
page {
  height: 100%;
  background-color: #f7f7f7;
}

.container {
  position: relative;
  height: 100%;
  width: 100%;
}

.main-scroll {
  width: 100%;
}

/* Banner区域样式 */
.banner {
  width: 100%;
  overflow: hidden;
}

/* 内容区域样式 */
.content {
  display: flex;
  min-height: calc(100vh - 200px); /* 减去banner高度 */
}

/* 分类列表样式 */
.category-list {
  width: 25%;
  background: #f5f5f5;
  box-sizing: border-box;
}

.category-list.fixed {
  position: fixed;
  top: 0;
  left: 0;
  opacity: 0; /* 原始元素隐藏，使用克隆元素 */
  pointer-events: none;
}

.fixed-clone {
  position: fixed;
  left: 0;
  width: 25%;
  background: #f5f5f5;
  z-index: 20;
  box-sizing: border-box;
}

.category-item {
  padding: 15px 10px;
  text-align: center;
  font-size: 14px;
  border-left: 3px solid transparent;
  transition: all 0.2s;
}

.category-item.active {
  background: #fff;
  border-left: 3px solid #FF4D4F;
  color: #FF4D4F;
  font-weight: bold;
}

/* 商品列表样式 */
.product-list {
  width: 75%;
  box-sizing: border-box;
  padding: 10px;
}

.product-item {
  display: flex;
  margin-bottom: 15px;
  background: #fff;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.product-image {
  width: 100px;
  height: 100px;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  padding: 10px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 14px;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

.product-price {
  font-size: 16px;
  color: #FF4D4F;
  font-weight: bold;
}

.product-sales {
  font-size: 12px;
  color: #999;
}

.loading-more {
  text-align: center;
  padding: 10px;
  color: #999;
  font-size: 12px;
}