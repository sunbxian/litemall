.product-list .item {
  display: flex; 
  background: #fff;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 10rpx;
 
}

.product-list .item .img {
  width: 200rpx;
  height: 200rpx;
  margin-right: 20rpx;
  flex-shrink: 0; /* 确保图标位置固定 */
  border-radius: 8rpx;
} 

.product-list .item .info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.product-list .item .info .name {
  font-size: 32rpx; /* 字体加大 */ 
  color: #000; /* 黑色 */
  margin-bottom: 10rpx;
  white-space: normal; /* 允许换行 */
  word-wrap: break-word; /* 长单词换行 */
  word-break: break-word; /* 强制长单词换行 */
  line-height: 40rpx; /* 增加行高以便更好显示多行文本 */
}

.product-list .item .info .desc {
  font-size: 24rpx;
  color: #666;
  white-space: normal; /* 允许换行 */
  word-wrap: break-word; /* 长单词换行 */
  word-break: break-word; /* 强制长单词换行 */
  line-height: 40rpx; /* 增加行高以便更好显示多行文本 */
  margin-bottom: 10rpx;
}

.product-list .item .info .price {
  display: flex;
  align-items: baseline; /* 对齐基线 */
}

.product-list .item .info .price .currency {
  font-size: 24rpx; /* ￥ 的字体大小 */
  color:  #FF4D4F;
  margin-right: 5rpx; /* 与价格的间距 */
}

.product-list .item .info .price .amount {
  font-size: 32rpx; /* 价格的字体大小 */
  color:   #FF4D4F;
  font-weight: bold; /* 加粗 */
}

.product-list .item .info .original-price {
  font-size: 24rpx; /* 原价字体大小 */
  color: #999; /* 灰色 */
  text-decoration: line-through; /* 删除线 */
  margin-bottom: 10rpx;
} 

.loading-more {
  text-align: center;
  padding: 10px;
  color: #999;
  font-size: 12px;
}

/* 优惠券样式 */
.coupon_item {
  position: relative;
  background: linear-gradient(136deg, #fdda96 0, #e3ad61 100%);
  margin: 0 0.5rem;
  margin-bottom: 0.75rem;
  display: flex;
  border-radius: 0.3rem;
}

.coupon_price {
  display: flex;
  width: 6rem;
  font-size: 0.7rem;
  text-align: center;
  justify-content: center;
  align-items: center;
  border-radius: 0.2rem;
  background: linear-gradient(136deg, #ff8787 0, #fb3636 100%);
}

.coupon_price .price {
  font-size: 1.8rem;
}

.coupon_price .p {
  margin-top: 0.25rem;
  font-size: 0.6rem;
}

.coupon_msg {
  flex: 1;
  padding: 0.3rem 0 0 0.35rem;
}

.coupon_condition {
  font-size: 0.8rem;
  line-height: 0.95rem;
  margin-bottom: 0.5rem;
}

.coupon_tag {
  display: inline-block;
  height: 0.7rem;
  color: #fff;
  line-height: 0.7rem;
  text-align: center;
  padding: 0 0.25rem;
  border-radius: 0.35rem;
  background-color: #fe5b5b;
}

.coupon_instruction {
  font-size: 0.65rem;
  margin-bottom: 0.5rem;
}

.coupon_date {
  font-size: 0.65rem;
  color: #999;
}

/* 悬浮优惠券样式 */
.coupon-float {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #fff;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.1);
  z-index: 1000;
  padding: 10rpx 0;
}

.coupon-scroll {
  display: flex;
  overflow-x: scroll;
  padding: 0 20rpx;
}

.coupon-item {
  flex-shrink: 0;
  margin-right: 20rpx;
  padding: 10rpx;
  background: linear-gradient(136deg, #fdda96 0, #e3ad61 100%);
  border-radius: 10rpx;
  text-align: center;
  color: #fff;
  font-size: 24rpx;
}

.coupon-price {
  font-size: 32rpx;
  font-weight: bold;
}

.coupon-desc {
  font-size: 20rpx;
  margin-top: 5rpx;
}

/* 关闭按钮样式 */
.close-btn {
  position: absolute;
  top: 10rpx;
  right: 20rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background-color: #ff4d4f;
  color: #fff;
  border-radius: 50%;
  font-size: 30rpx;
  z-index: 1001;
  cursor: pointer;
}