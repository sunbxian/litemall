/* 基础样式 */
page {
  height: 100%;
  background-color: #f7f7f7;
}

.container {
  position: relative;
  height: 100%;
  width: 100%;
}

.main-scroll {
  width: 100%;
}

/* Banner区域样式 */
.banner {
  width: 750rpx;
  height: 417rpx;
  overflow: hidden;
}

.banner image {
  width: 100%;
  height: 417rpx;
}

.banner-text {
  text-align: center;
  margin-top: 10px;
  color: #333;
  font-size: 14px;
  background-color: #fff; /* 添加背景色以确保文字清晰 */
  padding: 5px 0;
}

/* 内容区域样式 */
.content {
  display: flex;
  min-height: calc(100vh - 200px); /* 减去banner高度 */
  flex-wrap: nowrap; /* 确保子元素不换行 */
}

/* 分类列表样式 */
.category-list {
  width: 25%;
  background: #fff;
  box-sizing: border-box;
}

.category-list.fixed {
  position: fixed;
  top: 0;
  left: 0;
  opacity: 0; /* 原始元素隐藏，使用克隆元素 */
  pointer-events: none;
}

.fixed-clone {
  position: fixed;
  left: 0;
  width: 25%;
  background: #fff;
  z-index: 20;
  box-sizing: border-box;
}

.category-item {
  padding: 15px 10px;
  text-align: center;
  font-size: 14px;
  border-left: 3px solid transparent;
  transition: all 0.2s;
} 

.category-item.active {
  background: #f5f5f5;  
  border-left: 3px solid #ab956d;
  color: #ab956d;
  font-weight: bold;
}

/* 商品列表样式 */
.product-list {
  width: 75%;
  box-sizing: border-box;
  padding: 10px;
  flex-shrink: 0; /* 防止宽度被压缩 */
  background: #f5f5f5; 
}

.product-list .item {
  display: flex; 
  background: #fff;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 10rpx;
 
}

.product-list .item .img {
  width: 200rpx;
  height: 200rpx;
  margin-right: 20rpx;
  flex-shrink: 0; /* 确保图标位置固定 */
  border-radius: 8rpx;
} 

.product-list .item .info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.product-list .item .info .name {
  font-size: 32rpx; /* 字体加大 */ 
  color: #000; /* 黑色 */
  margin-bottom: 10rpx;
  white-space: normal; /* 允许换行 */
  word-wrap: break-word; /* 长单词换行 */
  word-break: break-word; /* 强制长单词换行 */
  line-height: 40rpx; /* 增加行高以便更好显示多行文本 */
}

.product-list .item .info .desc {
  font-size: 24rpx;
  color: #666;
  white-space: normal; /* 允许换行 */
  word-wrap: break-word; /* 长单词换行 */
  word-break: break-word; /* 强制长单词换行 */
  line-height: 40rpx; /* 增加行高以便更好显示多行文本 */
  margin-bottom: 10rpx;
}

.product-list .item .info .price {
  display: flex;
  align-items: baseline; /* 对齐基线 */
}

.product-list .item .info .price .currency {
  font-size: 24rpx; /* ￥ 的字体大小 */
  color:  #FF4D4F;
  margin-right: 5rpx; /* 与价格的间距 */
}

.product-list .item .info .price .amount {
  font-size: 32rpx; /* 价格的字体大小 */
  color:   #FF4D4F;
  font-weight: bold; /* 加粗 */
}

.product-list .item .info .original-price {
  font-size: 24rpx; /* 原价字体大小 */
  color: #999; /* 灰色 */
  text-decoration: line-through; /* 删除线 */
  margin-bottom: 10rpx;
} 

.loading-more {
  text-align: center;
  padding: 10px;
  color: #999;
  font-size: 12px;
}

/* 优惠券 */
.coupon_item {
    position: relative;
    /* background: linear-gradient(to right, #cfa568, #e3bf79); */
    background: linear-gradient(136deg,#fdda96 0,#e3ad61 100%);
    margin: 0 .5rem;
    margin-bottom: .75rem;
    display: flex;
    border-radius: .3rem;
}
.coupon_item view {
    color: #fff;
}

.coupon_price {
    display: flex;
    position: relative;
    width: 6rem;
    font-size: .7rem;
    text-align: center;
    -webkit-justify-content: center;
    -ms-flex-pack: center;
    justify-content: center;
    -webkit-align-items: center;
    -ms-flex-align: center;
    align-items: center;
    border-radius: .2rem;
    -webkit-box-shadow: 0 0.1rem 0.4rem 0 rgb(0 0 0 / 5%);
    box-shadow: 0 0.1rem 0.4rem 0 rgb(0 0 0 / 5%);
    background: linear-gradient(136deg,#ff8787 0,#fb3636 100%);
}
.coupon_price .price{
    line-height: 1;
    font-size: 1.8rem;
}
.coupon_price .p{
    margin-top: .25rem;
    font-size: .6rem;
    line-height: 1;
}
.coupon_msg{
    flex: 1;
    overflow: hidden;
    padding: .3rem 0 0 .35rem;
}
.coupon_condition{
    min-height: 1.8rem;
    line-height: .95rem;
    font-size: .6rem;
    padding-right: .6rem;
    text-overflow: ellipsis;
    overflow: hidden;
    display: -webkit-box;
    display: -webkit-inline-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}
.coupon_condition .text{
    font-size: 0.8rem;
    vertical-align: middle;
    display: inline;
    user-select: none;
    white-space: pre-wrap;
}
.coupon_tag{
    display: inline-block;
    height: .7rem;
    color: #fff;
    line-height: .7rem;
    text-align: center;
    padding: 0 .25rem;
    border-radius: .35rem;
    margin-right: .25rem;
    border-color: #fe5b5b;
    background-color: #fe5b5b;
}
.coupon_tag_text{
    font-size: .5rem;
}
.coupon_instruction{
    min-width: 7.5rem;
    height: .95rem;
    line-height: .95rem;
    padding-right: .6rem;
    text-overflow: ellipsis;
    overflow: hidden;
}
.coupon_date{
    font-size: .65rem;
    /* line-height: .5rem; */
    padding: .5rem 0;
    padding-right: .5rem;
    width: 100%;
}

/* 悬浮优惠券样式 */
@keyframes slideUp {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.coupon-float {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #fff;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.1);
  z-index: 1000;
  padding: 10rpx 0;
  animation: slideUp 0.3s ease-out; /* 添加弹出动画 */
  border-top-left-radius: 20rpx; /* 圆角效果 */
  border-top-right-radius: 20rpx;
}

.coupon-scroll {
  display: flex;
  overflow-x: scroll;
  padding: 0 20rpx;
}

.coupon-item {
  flex-shrink: 0;
  margin-right: 20rpx;
  padding: 10rpx;
  background: linear-gradient(136deg, #fdda96 0, #e3ad61 100%);
  border-radius: 10rpx;
  text-align: center;
  color: #fff;
  font-size: 24rpx;
}

.coupon-price {
  font-size: 32rpx;
  font-weight: bold;
}

.coupon-desc {
  font-size: 20rpx;
  margin-top: 5rpx;
}

.close-btn {
  position: absolute;
  top: -20rpx;
  right: 20rpx;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background-color: #ff4d4f;
  color: #fff;
  border-radius: 50%;
  font-size: 30rpx;
  z-index: 1001;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

/* 新增样式 */
.a-section {
  width: 750rpx;
  height: auto;
  overflow: hidden;
  background: #fff;
  color: #333;
  margin-top: 10rpx;
}

.a-section .h {
  display: flex;
  flex-flow: row nowrap;
  align-items: center;
  justify-content: center;
  height: 80rpx;
}

.a-section .h .txt {
  padding-right: 30rpx;
  background-size: 16.656rpx 27rpx;
  display: inline-block;
  height: 36rpx;
  font-size: 33rpx;
  line-height: 36rpx;
}